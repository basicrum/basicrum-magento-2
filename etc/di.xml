<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Basicrum\Analytics\Api\PageTypeDetectorInterface" type="Basicrum\Analytics\Model\PageTypeDetector" />
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="environment" xsi:type="array">
                <item name="basicrum/developer/development_mode" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>
    <!-- Merge at the same DI stage as Magento_Csp; frontend DI replaces this array. -->
    <type name="Magento\Csp\Model\CompositePolicyCollector">
        <arguments>
            <argument name="collectors" xsi:type="array">
                <item name="basicrum_beacon" xsi:type="object" sortOrder="50">Basicrum\Analytics\Model\Csp\BeaconPolicyCollector</item>
            </argument>
        </arguments>
    </type>
</config>
