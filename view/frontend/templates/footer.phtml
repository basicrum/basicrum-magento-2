<?php
declare(strict_types=1);

use BasicRum\Analytics\ViewModel\Footer;
use Magento\Framework\View\Element\Template;
use Magento\Framework\View\Helper\SecureHtmlRenderer;

/** @var Template $block */
/** @var Footer $viewModel */
/** @var SecureHtmlRenderer $secureRenderer */

$viewModel = $block->getViewModel();
$config = $viewModel->getConfig();

// Revalidate the effective store-scoped configuration even when the layout's
// ifconfig gate has already selected this block.
if ($config === null) {
    return;
}

$jsonFlags = JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT | JSON_UNESCAPED_SLASHES;
$boomerangUrl = $block->getViewFileUrl(
    'BasicRum_Analytics::js/boomr/boomerang-' . $viewModel->getBoomerangVersion() . '.cutting-edge.min.js'
);
$loaderName = $config['consent_enabled']
    ? 'consent-boomerang-loader-v1-15.min.js'
    : 'boomerang-loader-v15.min.js';
$loaderUrl = $block->getViewFileUrl('BasicRum_Analytics::js/loaders/' . $loaderName);

$boomerangVars = [
    ['addVar', 'p_type', $viewModel->getPageType()],
    ['addVar', 'p_gen', 'mage2'],
    ['addVar', 'brum_site_id', $config['brum_site_id']],
];
$boomerangConfig = [
    'beacon_url' => $config['beacon_endpoint'],
    'instrument_xhr' => false,
    'strip_query_string' => $config['strip_query_string'],
    'Continuity' => ['enabled' => true],
    'ResourceTiming' => [
        'enabled' => true,
        'splitAtPath' => true,
    ],
    'secure_cookie' => true,
    'same_site_cookie' => 'Strict',
];

$boomerangVarsJson = json_encode($boomerangVars, $jsonFlags);
$boomerangUrlJson = json_encode($boomerangUrl, $jsonFlags);
$boomerangConfigJson = json_encode($boomerangConfig, $jsonFlags);

if ($boomerangVarsJson === false || $boomerangUrlJson === false || $boomerangConfigJson === false) {
    return;
}

$waitScript = '';
if ($config['wait_after_onload'] && $config['delay_ms'] > 0) {
    $delayMs = (int) $config['delay_ms'];
    $waitScript = <<<JS

    b.plugins = b.plugins || {};
    b.plugins.WaitAfterOnload = {
        complete: false,
        timer: null,
        init: function() {
            b.subscribe("page_ready", function() {
                this.timer = w.setTimeout(function() {
                    this.timer = null;
                    if (w.basicRumConsentWithdrawn) {
                        return;
                    }
                    this.complete = true;
                    b.sendBeacon();
                }.bind(this), {$delayMs});
            }, {}, this);
        },
        is_complete: function() {
            return this.complete;
        }
    };
JS;
}

$scriptString = <<<JS
(function(w) {
    if (!w) {
        return;
    }

    w.BOOMR_mq = w.BOOMR_mq || [];
    w.BOOMR_mq.push.apply(w.BOOMR_mq, {$boomerangVarsJson});

    w.BOOMR = w.BOOMR || {};
    var b = w.BOOMR;
    b.url = {$boomerangUrlJson};
{$waitScript}
    w.basicRumBoomerangConfig = {$boomerangConfigJson};
})(window);
JS;
?>
<?= /* @noEscape */ $secureRenderer->renderTag(
    'script',
    ['data-cfasync' => 'false'],
    $scriptString,
    false
) ?>
<?= /* @noEscape */ $secureRenderer->renderTag(
    'script',
    ['src' => $loaderUrl, 'async' => 'true', 'data-cfasync' => 'false'],
    '',
    false
) ?>
